# Velxio personal key for QEMU downloads during Docker Compose builds.
# Velxio's download server uses this key to authorize access to its prebuilt QEMU files.
# Leave it blank if prebuilt/qemu/ already contains the two libraries and four ROM files.
VELXIO_LICENSE_KEY=

# Built-in autocomplete (ready to use)
# The editor uses bundled symbol dictionaries for C/C++, Arduino, Python, and
# MicroPython. Type Serial. in an Arduino sketch or press Ctrl+Space.
# Suggestions include unsaved code, installed Arduino library headers, and
# symbols from included libraries. YAML uses schemas to suggest keys, including
# in ESP-IDF manifests.

# Optional language servers
# These add context-aware completions, hover, signature help, Go to Definition,
# and live diagnostics for supported boards.
VELXIO_ENABLE_LANGUAGE_SERVERS=0

# Docker
# 1. Set VELXIO_ENABLE_LANGUAGE_SERVERS=1 above.
# 2. Run docker compose up -d --build to install the tools and restart Velxio.
#    Put files needed by the server under ./data and use /app/data in paths below.

# Native backend
# 1. Install the tools listed for your board and make them available on PATH.
# 2. Export VELXIO_ENABLE_LANGUAGE_SERVERS=1 before starting the backend.
# Uncomment an override below only if you need to supply a path. For a native
# setup, replace the /app/data examples with paths on your machine.

# Arduino Uno, Nano, and Mega use Arduino Language Server, clangd, and Arduino CLI.
# VELXIO_ARDUINO_LANGUAGE_SERVER=arduino-language-server
# VELXIO_CLANGD=clangd
# VELXIO_INTELLISENSE_ARDUINO_CLI=arduino-cli
# VELXIO_INTELLISENSE_CLI_CONFIG=/app/data/intellisense/arduino-cli.yaml

# Optional override for the library directory used by Arduino autocomplete.
# VELXIO_SYMBOL_LIBRARIES_DIR=/app/data/intellisense/libraries

# MicroPython uses Pyright. Put matching firmware stubs in the rp2-pico,
# rp2-pico-w, or esp32 subfolder of the stubs directory you set below.
# VELXIO_PYRIGHT_LANGSERVER=pyright-langserver
# VELXIO_MICROPYTHON_STUBS=/app/data/intellisense/stubs

# ESP-IDF on ESP32-C3 uses clangd. Point to your generated compile_commands.json.
# The SDK and toolchain paths inside it must also be accessible to the backend.
# VELXIO_ESPIDF_INTELLISENSE_DB=/app/data/intellisense/compile_commands.json
