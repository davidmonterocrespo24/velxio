# Velxio personal key for QEMU downloads during Docker Compose builds.
# Velxio's download server uses this key to authorize access to its prebuilt QEMU files.
# Leave it blank if prebuilt/qemu/ already contains the two libraries and four ROM files.
VELXIO_LICENSE_KEY=

# Built-in completions (default). Type Serial. in an Arduino sketch or press Ctrl+Space.
VELXIO_ENABLE_LANGUAGE_SERVERS=0

# For hover, Go to Definition, and diagnostics on supported boards:
# Docker: Set the flag above to 1, then run docker compose up -d --build.
# Native: Install the tools below, export the flag as 1, then start the backend.
# Only uncomment overrides you need. Docker sees ./data as /app/data.

# Arduino Uno, Nano, and Mega: Arduino Language Server, clangd, and Arduino CLI.
# VELXIO_ARDUINO_LANGUAGE_SERVER=arduino-language-server
# VELXIO_CLANGD=clangd
# VELXIO_INTELLISENSE_ARDUINO_CLI=arduino-cli
# VELXIO_INTELLISENSE_CLI_CONFIG=/app/data/intellisense/arduino-cli.yaml
# VELXIO_SYMBOL_LIBRARIES_DIR=/app/data/intellisense/libraries

# MicroPython: Install Pyright and put matching stubs in rp2-pico, rp2-pico-w, or esp32 subfolders.
# VELXIO_PYRIGHT_LANGSERVER=pyright-langserver
# VELXIO_MICROPYTHON_STUBS=/app/data/intellisense/stubs

# ESP32-C3 with ESP-IDF: Install clangd and point to a compile_commands.json the backend can use.
# VELXIO_ESPIDF_INTELLISENSE_DB=/app/data/intellisense/compile_commands.json
